# ---------- FRONTEND (Vite) ----------
# Estes dois são os ÚNICOS segredos que podem existir no frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL do grupo da AI League (CTA do Perfil). Opcional.
VITE_AI_LEAGUE_URL=https://chat.whatsapp.com/xxxxxxxx

# ---------- EDGE FUNCTIONS (supabase secrets set ...) ----------
# NUNCA colocar estes no frontend / nunca prefixar com VITE_
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem por padrão no runtime
# das Edge Functions do Supabase; só defina se precisar sobrescrever.
#
# SUPABASE_SERVICE_ROLE_KEY=
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=      (base64 da chave privada, como o Mux entrega)
# MUX_WEBHOOK_SECRET=
# APP_ORIGIN=https://academy.kalidash.com

# URL opcional do CTA "Desbloquear acesso" (WhatsApp/página de contato).
# Sem ela, o modal apenas explica o acesso pago.
VITE_UNLOCK_URL=
